/* =============================================
   CUSTOM OVERRIDES — angelife site
   ============================================= */

/* 去装饰：H2 竖条（polk-x 主题 .post-content h2::before） */
.post .post-content h2::before {
  display: none !important;
}

/* 去装饰：引用块去背景和边框 */
.post blockquote {
  background: transparent !important;
  border-left: none !important;
  padding-left: 1.2em !important;
  color: var(--c-muted) !important;
}

.post blockquote p {
  margin: 0.3em 0 !important;
}

/* 隐藏右上角主题切换按钮 */
.theme-toggle {
  display: none !important;
}

/* .toc 隐藏（兜底） */
.toc {
  display: none !important;
}

/* === naosense homepage layout only === */

/* 1. 隐藏副标题 */
.header .subtitle,
.site-description,
.tagline {
  display: none !important;
}

/* 2. 标题改书法字体，细体 */
.header .blog-title,
.site-title,
h1.title {
  font-family: "STKaiti", "楷体", "KaiTi", "Hiragino Mincho ProN", "SimSun", Georgia, serif !important;
  font-weight: normal !important;
  font-size: 2.2rem !important;
  letter-spacing: 0.05em !important;
}

/* 3. 导航收紧间距 */
.menu a, nav a {
  font-size: 0.95rem !important;
  margin: 0 0.6rem !important;
}

/* 4. 首页整体垂直居中 */
.home {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 70vh !important;
  text-align: center !important;
}
